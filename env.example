# Copy to .env.local and fill in values you need.
# .env.local is gitignored; never commit real secrets.

# --- Mode ---
# Omit or set to "local" for SQLite. Set "cloud" for Supabase Postgres + Auth.
# DEPLOYMENT_MODE=local
# DEPLOYMENT_MODE=cloud

# --- Local / self-hosted (SQLite) ---
# Optional. Defaults to ./paisa-watch.db (browser) or appData/Paisa-Watch (Electron).
# DATABASE_PATH=./paisa-watch.db

# --- Cloud auth backend (DEPLOYMENT_MODE=cloud only) ---
# Omit or set to "supabase" (default) for Supabase Auth. Set "simple" for static email/password
# accounts with no external provider — see README "Option D" / docs/adr/0015-*.md.
# AUTH_PROVIDER=simple

# --- Cloud (Supabase Auth) — required when DEPLOYMENT_MODE=cloud and AUTH_PROVIDER=supabase (default) ---
# Project URL and publishable (anon) key from Supabase → Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Simple auth — required when DEPLOYMENT_MODE=cloud and AUTH_PROVIDER=simple ---
# Comma-separated email:password accounts, no sign-up flow, no users table. Each email is its
# own isolated Owner — one person's password never shows another email's data. There is no
# password reset; edit this list and redeploy. Passwords may not contain ',' or ':'.
# AUTH_USERS=owner1@example.com:pass1,owner2@example.com:pass2

# Postgres connection for migrations / server DB access — any Postgres, not only Supabase's.
# On Supabase, prefer the Session pooler URI (port 5432), not the direct db.* host or Transaction pooler (6543).
# POSTGRES_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Required in cloud mode once any Owner configures Email Alert Sync — encrypts the IMAP username
# and password at rest (docs/adr/0012-imap-credentials-encrypted-at-rest-with-app-layer-key.md).
# Base64-encoded 32 bytes (AES-256). Generate with: openssl rand -base64 32
# Losing this key makes every already-saved IMAP credential unrecoverable — back it up like any other secret.
# EMAIL_SYNC_ENCRYPTION_KEY=

# Vercel Cron auth for /api/cron/email-sync (cloud). Required in production; local cloud
# can use any string of at least 32 characters for manual curl tests (openssl rand -hex 32).
# CRON_SECRET=
